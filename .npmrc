# .npmrc — MumuSpec npm configuration
#
# This file configures npm publish/install behavior for both production
# releases (public npm registry) and test/prerelease releases (tagged `next`).
#
# For local end-to-end testing of the publish flow without hitting the real
# registry, see docs/reference/packaging-deployment.md §"本地试发布流程"
# (uses `npm publish --dry-run` and verdaccio).

# Default registry — public npm. Override per-invocation via --registry:
#   npm publish --registry https://npm.pkg.github.com  (GitHub Packages)
#   npm publish --registry http://localhost:4873       (verdaccio local)
registry=https://registry.npmjs.org/

# Auth token for the public registry (set via env in CI, not committed).
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Fail `npm publish` if the package already exists at the target version.
# Default behavior, stated explicitly for clarity.
allow-same-version=false

# When `npm publish` runs, also tag the version. Default tag is `latest`;
# we override per-release via `npm publish --tag next` for prereleases.
# (No setting here — tag is controlled by the release scripts.)

# Send access=public for scoped packages. MumuSpec is unscoped, so this
# is a no-op for our own publishes, but keeps behavior consistent for
# scoped sub-packages if added later.
access=public
